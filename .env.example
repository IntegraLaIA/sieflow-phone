# SieFlow Phone needs no settings to start: open it in the browser and the guided
# setup asks for everything (Meta app, number, webhook, calling, team).
# Anything set here wins over the wizard and shows up there as read-only.
# Lines starting with # are ignored.

# ---- HTTPS with the bundled Caddy (docker compose --profile https) --------

DOMAIN=phone.example.com
# HTTP_PORT=8080

# Image tag to run; pin a release so upgrades are deliberate.
# SIEFLOW_PHONE_VERSION=0.1.0

# ---- Setup -------------------------------------------------------------------

# The first administrator is created with a code printed in the logs
# (docker compose logs sieflow-phone). Set it here if you prefer a fixed one.
# SETUP_CODE=

# Public address, used to suggest the webhook URL.
# PUBLIC_URL=https://phone.example.com

# ---- Meta (optional: the wizard can store these) -----------------------------

# WA_APP_ID=
# WA_APP_SECRET=
# WA_ACCESS_TOKEN=
# WA_WABA_ID=
# WA_PHONE_NUMBER_ID=
# WA_VERIFY_TOKEN=
# WA_DISPLAY_NUMBER=
# WA_GRAPH_VERSION=v24.0
# PERMISSION_REQUEST_TEXT=We would like to call you on WhatsApp about your request. Is that OK?

# ---- Operators (optional: the wizard manages them too) -----------------------

# Administrators defined here cannot be edited in the UI. One name:hash pair
# per entry, separated by commas. Create a hash with:
#   docker compose run --rm sieflow-phone node src/cli.js hash-password
# USERS=
# USERS_FILE=/run/secrets/sieflow_phone_users

# Sessions survive restarts with a secret SieFlow Phone stores in its database.
# Set one here only if you want to manage it yourself (openssl rand -hex 32).
# SESSION_SECRET=
# SESSION_TTL_HOURS=12

# ---- NAT traversal (optional) ----------------------------------------------
# WhatsApp media servers have public IPs, so most networks connect directly.
# Add TURN for operators on networks that block UDP.

# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# With the bundled coturn (docker compose --profile turn), short-lived credentials per operator:
# TURN_URLS=turn:phone.example.com:3478?transport=udp,turn:phone.example.com:3478?transport=tcp
# TURN_SECRET=
# TURN_TTL_SECONDS=3600
# Or a TURN provider with static credentials:
# TURN_USERNAME=
# TURN_PASSWORD=

# ---- Other ---------------------------------------------------------------

# Meta allows one webhook URL per app. If another backend already receives your
# WhatsApp messages, SieFlow Phone can forward every webhook to it, signature included.
# WEBHOOK_FORWARD_URL=https://your-backend.example.com/whatsapp/webhook

# Delete messages and call records older than this many days (privacy policies,
# Ley 1581, GDPR). Unset keeps everything.
# RETENTION_DAYS=365

# LOG_LEVEL=info

# Try SieFlow Phone without Meta: mock WhatsApp API plus a user simulator at /simulator.
# Never on a public server.
# DEMO_MODE=true
